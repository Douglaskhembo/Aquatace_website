# Copy to .env on the VPS (never commit the real file — it's gitignored).
# docker-compose.yml uses this as the running container's env_file.

# Native Postgres 17 on the VPS. Use a dedicated app role/database, not the
# postgres superuser, once you've set this up (see db/schema.sql).
DATABASE_URL=postgresql://aquatace:CHANGE_ME@localhost:5432/aquatace

# Signs/verifies admin login JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=

NODE_ENV=production
PORT=3000

# Where uploaded product/gallery images are stored (mounted as a Docker
# volume in docker-compose.yml — don't change unless you also change the
# volume mount).
UPLOADS_DIR=/app/uploads

# Optional: enables Google Routes API distance/duration lookups for order
# assignment. Without these, delivery distance falls back to a straight-line
# (haversine) estimate — the app works fine either way.
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=
